{
  "name": "sorapaper-astro-theme",
  "version": "1.0.0",
  "description": "A soft, content-first Astro blog theme for long-form writing.",
  "keywords": [
    "astro",
    "astro-theme",
    "blog",
    "blog-theme",
    "static-site",
    "markdown",
    "mdx",
    "i18n"
  ],
  "license": "MIT",
  "author": "AllsVoid",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AllsVoid/sorapaper.git"
  },
  "bugs": {
    "url": "https://github.com/AllsVoid/sorapaper/issues"
  },
  "homepage": "https://github.com/AllsVoid/sorapaper#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.7.0",
  "files": [
    "src/",
    "public/",
    "astro.config.mjs",
    "sorapaper.ts",
    "tsconfig.json",
    "wrangler.jsonc",
    "pnpm-workspace.yaml",
    "scripts/npm-package-lock.mjs",
    ".sorapaper-package/pnpm-lock.yaml",
    "CHANGELOG.md",
    "docs/design-handoff.md",
    "docs/development-guide.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test src/lib/markdown/*.test.mjs",
    "release:check": "pnpm run check && pnpm run test && pnpm run build && npm pack --dry-run",
    "prepublishOnly": "pnpm run release:check",
    "prepack": "node scripts/npm-package-lock.mjs prepare",
    "postpack": "node scripts/npm-package-lock.mjs clean"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.1",
    "@astrojs/mdx": "7.0.2",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@expo-google-fonts/noto-sans-sc": "0.4.3",
    "@resvg/resvg-js": "2.6.2",
    "aplayer": "1.10.1",
    "astro": "7.0.6",
    "hast-util-to-html": "9.0.5",
    "katex": "0.17.0",
    "mermaid": "11.16.0",
    "meting": "2.0.2",
    "qrcode": "1.5.4",
    "rehype-katex": "7.0.1",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@types/qrcode": "1.5.6",
    "pagefind": "1.5.2",
    "typescript": "6.0.3"
  }
}
