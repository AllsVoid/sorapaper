---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { locales } from "@/i18n/config";
import { getUi } from "@/i18n/ui";
---

<BaseLayout title="Travel" description="Travel notes and map records.">
  {locales.map((locale) => {
    const t = getUi(locale);
    return (
      <section class="container travel" data-lang={locale}>
        <header>
          <span class="pill">{t.nav.travel}</span>
          <h1>{t.pages.travelTitle}</h1>
          <p class="muted">{t.pages.travelDescription}</p>
        </header>

        <section class="map-shell glass" aria-label={t.pages.travelEmptyTitle}>
          <div class="map-art" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div>
            <h2>{t.pages.travelEmptyTitle}</h2>
            <p>{t.pages.travelEmptyDescription}</p>
          </div>
        </section>
      </section>
    );
  })}
</BaseLayout>

<style>
  .travel {
    padding: 3.2rem 0 0;
  }

  header {
    width: min(100%, var(--article));
    margin-inline: auto;
  }

  h1 {
    margin: 1rem 0 0.6rem;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    letter-spacing: 0;
    line-height: 1.08;
  }

  .map-shell {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(260px, 0.75fr);
    gap: clamp(1rem, 4vw, 2rem);
    align-items: center;
    min-height: 24rem;
    margin-top: 2rem;
    border-radius: var(--radius-xl);
    padding: clamp(1.1rem, 4vw, 2rem);
  }

  .map-art {
    position: relative;
    min-height: 19rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background:
      linear-gradient(120deg, color-mix(in srgb, var(--primary) 18%, transparent) 0 1px, transparent 1px 72px),
      linear-gradient(30deg, color-mix(in srgb, var(--secondary) 16%, transparent) 0 1px, transparent 1px 68px),
      radial-gradient(circle at 28% 32%, color-mix(in srgb, var(--primary) 24%, transparent), transparent 22%),
      radial-gradient(circle at 74% 68%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 24%),
      var(--surface-strong);
  }

  .map-art::before {
    position: absolute;
    inset: 18% 14% 24% 18%;
    border: 2px dashed color-mix(in srgb, var(--primary) 42%, transparent);
    border-radius: 52% 48% 58% 42%;
    content: "";
    transform: rotate(-8deg);
  }

  .map-art span {
    position: absolute;
    width: 1rem;
    height: 1rem;
    border: 3px solid var(--surface-strong);
    border-radius: 999px;
    background: var(--primary);
    box-shadow: var(--shadow-soft);
  }

  .map-art span:nth-child(1) {
    left: 27%;
    top: 35%;
  }

  .map-art span:nth-child(2) {
    right: 29%;
    top: 29%;
    background: var(--secondary);
  }

  .map-art span:nth-child(3) {
    left: 54%;
    bottom: 25%;
    background: var(--accent);
  }

  h2 {
    margin: 0 0 0.75rem;
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.2;
  }

  p {
    margin: 0;
    color: var(--muted);
    line-height: 1.8;
  }

  @media (max-width: 820px) {
    .map-shell {
      grid-template-columns: 1fr;
    }
  }
</style>
