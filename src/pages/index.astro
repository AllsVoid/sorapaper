---
import HeroSection from "@/components/HeroSection.astro";
import PostCard from "@/components/PostCard.astro";
import TravelCard from "@/components/TravelCard.astro";
import Sidebar from "@/components/Sidebar.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { locales, localizePath } from "@/i18n/config";
import { getUi } from "@/i18n/ui";
import { getPinnedPosts, getPublishedPosts } from "@/lib/posts";
import { getPublishedTravels } from "@/lib/travel";

const localeData = await Promise.all(
  locales.map(async (locale) => {
    const posts = await getPublishedPosts(locale);
    const pinned = await getPinnedPosts(locale);
    const featuredPosts = pinned.length > 0 ? pinned : posts.slice(0, 1);
    const allTravels = await getPublishedTravels();
    const localizedTravels = await getPublishedTravels(locale);
    const travels = localizedTravels.length > 0 ? localizedTravels : allTravels;
    const items = [
      ...featuredPosts.map((post) => ({ type: "post" as const, entry: post, featured: true })),
      ...travels.map((travel) => ({ type: "travel" as const, entry: travel, featured: false })),
      ...posts.filter((post) => !featuredPosts.includes(post)).map((post) => ({ type: "post" as const, entry: post, featured: false }))
    ].slice(0, 6);
    return { locale, t: getUi(locale), items };
  })
);
---

<BaseLayout>
  <div class="container">
    {localeData.map(({ locale, t, items }) => (
      <div class="home-page" data-lang={locale}>
        <HeroSection locale={locale} />
        <section class="home-grid">
          <div>
            <div class="section-title">
              <h2>{t.home.latestPosts}</h2>
              <a href={localizePath(locale, "/archive/")}>{t.home.viewAll} →</a>
            </div>
            <div class="posts">
              {items.map((item) => item.type === "post" ? (
                <PostCard post={item.entry} locale={locale} featured={item.featured} />
              ) : (
                <TravelCard travel={item.entry} locale={locale} />
              ))}
            </div>
          </div>
          <Sidebar locale={locale} />
        </section>
      </div>
    ))}
  </div>
</BaseLayout>

<style>
  .home-page {
    --home-aside: clamp(15rem, 24vw, 19.5rem);
    --home-gap: clamp(1rem, 1.6vw, 1.4rem);
    --home-section-gap: 1rem;
  }

  .home-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--home-aside);
    gap: var(--home-gap);
    align-items: start;
  }

  .section-title h2 {
    margin: 0;
    font-size: 1.14rem;
  }

  .section-title a {
    color: var(--primary);
    font-size: 0.92rem;
  }

  .section-title {
    margin-bottom: var(--home-section-gap);
  }

  .posts {
    display: grid;
    gap: 1rem;
  }

  @media (max-width: 940px) {
    .home-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
