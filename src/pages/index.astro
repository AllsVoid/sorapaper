---
import HeroSection from "@/components/HeroSection.astro";
import PostCard from "@/components/PostCard.astro";
import Sidebar from "@/components/Sidebar.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAllTags, getPinnedPosts, getPublishedPosts } from "@/lib/posts";

const posts = await getPublishedPosts();
const pinned = await getPinnedPosts();
const tags = getAllTags(posts);
const featuredPosts = pinned.length > 0 ? pinned : posts.slice(0, 1);
---

<BaseLayout>
  <div class="container">
    <HeroSection />
    <section class="home-grid">
      <div>
        <div class="section-title">
          <h2>Latest Posts</h2>
          <a href="/archive/">View all →</a>
        </div>
        <div class="posts">
          {[...featuredPosts, ...posts.filter((post) => !featuredPosts.includes(post)).slice(0, 5)].map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </div>
      <Sidebar tags={tags} />
    </section>
  </div>
</BaseLayout>

<style>
  .home-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 310px;
    gap: 1.2rem;
    align-items: start;
  }

  .section-title h2 {
    margin: 0;
    font-size: 1.14rem;
  }

  .section-title a {
    color: var(--primary);
    font-size: 0.92rem;
  }

  .posts {
    display: grid;
    gap: 1rem;
  }

  @media (max-width: 940px) {
    .home-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
