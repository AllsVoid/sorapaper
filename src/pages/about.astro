---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { themeConfig } from "@/config/theme";
import { locales } from "@/i18n/config";
import { getUi } from "@/i18n/ui";
---

<BaseLayout title="About" description={themeConfig.description}>
  <section class="container about">
    <div class="intro glass">
      <img src={themeConfig.author.avatar} alt="" width="112" height="112" />
      <div>
        {locales.map((locale) => {
          const t = getUi(locale);
          return (
            <div data-lang={locale}>
              <span class="pill">{t.pages.aboutTitle}</span>
              <h1>{themeConfig.author.name}</h1>
              <p>{themeConfig.author.bio}</p>
            </div>
          );
        })}
      </div>
    </div>

    {locales.map((locale) => (
      <div class="cards" data-lang={locale}>
        <section class="glass">
          <h2>{locale === "zh" ? "主题理念" : "Theme Philosophy"}</h2>
          <p>{locale === "zh" ? "SoraPaper 将写作视为主要界面。视觉层通过柔和渐变、玻璃卡片和充足留白提供平静氛围。" : "SoraPaper treats writing as the main interface. The visual layer adds calm atmosphere through soft gradients, glass cards and generous spacing."}</p>
        </section>
        <section class="glass">
          <h2>{locale === "zh" ? "技术栈" : "Stack"}</h2>
          <p>{locale === "zh" ? "Astro、Content Collections、MDX、CSS variables，以及可选的搜索、评论和统计静态集成。" : "Astro, Content Collections, MDX, CSS variables, optional static integrations for search, comments and analytics."}</p>
        </section>
        <section class="glass">
          <h2>{locale === "zh" ? "路线" : "Timeline"}</h2>
          <p>{locale === "zh" ? "先设计 token，再设计内容模型，然后搭建页面，最后用动效和可选生态功能打磨。" : "Design tokens first, content model second, pages third, then polish with motion and optional ecosystem features."}</p>
        </section>
      </div>
    ))}
  </section>
</BaseLayout>

<style>
  .about {
    padding: 3.2rem 0 0;
  }

  .intro {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.4rem;
    align-items: center;
    border-radius: var(--radius-xl);
    padding: clamp(1.2rem, 4vw, 2rem);
  }

  img {
    border: 6px solid var(--surface-strong);
    border-radius: 999px;
    box-shadow: var(--shadow-soft);
  }

  h1 {
    margin: 1rem 0 0.55rem;
    font-family: var(--font-serif);
    font-size: clamp(2.6rem, 7vw, 5rem);
    letter-spacing: -0.06em;
    line-height: 1.02;
  }

  p {
    margin: 0;
    color: var(--muted);
    line-height: 1.8;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .cards section {
    border-radius: var(--radius-lg);
    padding: 1.25rem;
  }

  h2 {
    margin: 0 0 0.55rem;
    font-size: 1.1rem;
  }

  @media (max-width: 820px) {
    .intro,
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
