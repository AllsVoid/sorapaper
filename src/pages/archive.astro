---
import PostCard from "@/components/PostCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getArchiveGroups, getPublishedPosts } from "@/lib/posts";

const posts = await getPublishedPosts();
const groups = getArchiveGroups(posts);
---

<BaseLayout title="Archive" description="Browse all posts by year.">
  <section class="container page">
    <header>
      <span class="pill">Archive</span>
      <h1>All writing, grouped by year</h1>
      <p class="muted">{posts.length} published posts in the garden.</p>
    </header>

    <div class="groups">
      {groups.map(([year, yearPosts]) => (
        <section class="year">
          <h2>{year}</h2>
          <div class="posts">
            {yearPosts.map((post) => <PostCard post={post} />)}
          </div>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .page {
    padding: 3.2rem 0 0;
  }

  header {
    width: min(100%, var(--article));
    margin-inline: auto;
  }

  h1 {
    margin: 1rem 0 0.6rem;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    letter-spacing: -0.06em;
    line-height: 1.02;
  }

  .groups {
    display: grid;
    gap: 2rem;
    width: min(100%, 880px);
    margin: 2rem auto 0;
  }

  .year h2 {
    margin: 0 0 1rem;
    color: var(--primary);
  }

  .posts {
    display: grid;
    gap: 1rem;
  }
</style>
