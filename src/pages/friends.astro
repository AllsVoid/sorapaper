---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { locales } from "@/i18n/config";
import { getUi } from "@/i18n/ui";

const friends = await getCollection("friends");
---

<BaseLayout title="Friends" description="Friendly links and neighbors.">
  {locales.map((locale) => {
    const t = getUi(locale);
    return (
      <section class="container page" data-lang={locale}>
        <header>
          <span class="pill">{t.nav.friends}</span>
          <h1>{t.pages.friendsTitle}</h1>
          <p class="muted">{t.pages.friendsDescription}</p>
        </header>

        <div class="friends">
          {friends.map((friend) => (
            <a class="friend glass" href={friend.data.href} target="_blank" rel="noreferrer">
              <img src={friend.data.avatar ?? "/avatar.svg"} alt="" width="58" height="58" />
              <div>
                <h2>{friend.data.name}</h2>
                <p>{friend.data.description}</p>
                <div>
                  {friend.data.tags.map((tag) => <span>{tag}</span>)}
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
    );
  })}
</BaseLayout>

<style>
  .page {
    padding: 3.2rem 0 0;
  }

  header {
    width: min(100%, var(--article));
    margin-inline: auto;
  }

  h1 {
    margin: 1rem 0 0.6rem;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    letter-spacing: -0.06em;
    line-height: 1.02;
  }

  .friends {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  .friend {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    border-radius: var(--radius-lg);
    padding: 1rem;
  }

  .friend:hover {
    border-color: color-mix(in srgb, var(--primary) 38%, var(--border));
  }

  img {
    border-radius: 999px;
  }

  h2,
  p {
    margin: 0;
  }

  h2 {
    font-size: 1.05rem;
  }

  p {
    color: var(--muted);
    line-height: 1.65;
  }

  .friend div div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.7rem;
  }

  span {
    border-radius: 999px;
    background: var(--tag);
    color: var(--muted);
    font-size: 0.78rem;
    padding: 0.26rem 0.5rem;
  }
</style>
