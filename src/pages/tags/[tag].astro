---
import PostCard from "@/components/PostCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { locales, localizePath } from "@/i18n/config";
import { getUi } from "@/i18n/ui";
import { getAllTags, getPublishedPosts } from "@/lib/posts";

export async function getStaticPaths() {
  const tags = new Map<string, string>();
  for (const locale of locales) {
    const posts = await getPublishedPosts(locale);
    for (const tag of getAllTags(posts)) {
      tags.set(tag.slug, tag.name);
    }
  }
  return [...tags.entries()].map(([slug, name]) => ({ params: { tag: slug }, props: { tag: name } }));
}

const { tag } = Astro.props;
const localeData = await Promise.all(
  locales.map(async (locale) => {
    const posts = (await getPublishedPosts(locale)).filter((post) =>
      post.data.tags.some((item) => item.toLowerCase() === String(tag).toLowerCase())
    );
    return { locale, t: getUi(locale), posts };
  })
);
---

<BaseLayout title={`#${tag}`} description={`Posts tagged ${tag}.`}>
  {localeData.map(({ locale, t, posts }) => (
    <section class="container page" data-lang={locale}>
      <header>
        <a class="pill" href={localizePath(locale, "/tags/")}>← {t.nav.tags}</a>
        <h1>#{tag}</h1>
        <p class="muted">{posts.length} {t.pages.taggedDescription}</p>
      </header>

      <div class="posts">
        {posts.map((post) => <PostCard post={post} locale={locale} />)}
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  .page {
    padding: 3.2rem 0 0;
  }

  header,
  .posts {
    width: min(100%, var(--article));
    margin-inline: auto;
  }

  h1 {
    margin: 1rem 0 0.6rem;
    font-family: var(--font-serif);
    font-size: clamp(2.8rem, 7vw, 5rem);
    letter-spacing: -0.06em;
    line-height: 1.02;
  }

  .posts {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }
</style>
