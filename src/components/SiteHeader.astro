---
import ThemeToggle from "@/components/ThemeToggle.astro";
import SearchDialog from "@/components/SearchDialog.astro";
import { themeConfig } from "@/config/theme";
import { localeLabels, localizePath, switchLocalePath, type Locale } from "@/i18n/config";
import { getUi } from "@/i18n/ui";

interface Props {
  locale: Locale;
  currentPath: string;
  alternatePath?: string;
}

const { locale, currentPath, alternatePath } = Astro.props;
const t = getUi(locale);
const nav = [
  { label: t.nav.home, href: "/" },
  { label: t.nav.archive, href: "/archive/" },
  { label: t.nav.tags, href: "/tags/" },
  { label: t.nav.about, href: "/about/" },
  { label: t.nav.friends, href: "/friends/" }
];
---

<header class="site-header container glass">
  <a class="brand" href={localizePath(locale)} aria-label={`${themeConfig.name} ${t.nav.home}`}>
    <img src="/favicon.svg" alt="" width="34" height="34" />
    <span>Sora<span>Paper</span></span>
  </a>

  <nav class="nav" aria-label="Primary navigation">
    {nav.map((item) => <a href={localizePath(locale, item.href)}>{item.label}</a>)}
  </nav>

  <div class="actions">
    <button class="scheme" type="button" aria-label="Change color scheme" data-scheme-toggle>◌</button>
    <button class="search" type="button" aria-label={t.search.ariaOpen} data-search-trigger>⌕</button>
    <a class="language" href={alternatePath ?? switchLocalePath(locale === "zh" ? "en" : "zh", currentPath)} aria-label="Switch language">
      {localeLabels[locale === "zh" ? "en" : "zh"]}
    </a>
    <ThemeToggle />
  </div>
</header>
<SearchDialog locale={locale} />

<script>
  const schemes = ["paper", "sakura", "moon", "ocean"];
  const button = document.querySelector("[data-scheme-toggle]");

  button?.addEventListener("click", () => {
    const current = document.documentElement.dataset.scheme ?? "paper";
    const next = schemes[(schemes.indexOf(current) + 1) % schemes.length];
    document.documentElement.dataset.scheme = next;
    localStorage.setItem("scheme", next);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 1rem;
    z-index: 20;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
    border-radius: var(--radius-lg);
    padding: 0.7rem 1rem;
  }

  .brand,
  .nav,
  .actions {
    display: flex;
    align-items: center;
  }

  .brand {
    gap: 0.65rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .brand span span {
    color: var(--primary);
  }

  .nav {
    justify-content: center;
    gap: 0.35rem;
  }

  .nav a {
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.92rem;
    padding: 0.62rem 0.88rem;
  }

  .nav a:hover {
    background: var(--tag);
    color: var(--text);
  }

  .actions {
    justify-content: flex-end;
    gap: 0.5rem;
  }

  .search,
  .scheme,
  .language {
    display: inline-grid;
    height: 2.5rem;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface-strong);
    color: var(--text);
    cursor: pointer;
    box-shadow: var(--shadow-soft);
  }

  .search,
  .scheme {
    width: 2.5rem;
  }

  .language {
    min-width: 3.2rem;
    font-size: 0.82rem;
    padding-inline: 0.7rem;
  }

  @media (max-width: 780px) {
    .site-header {
      grid-template-columns: 1fr auto;
    }

    .nav {
      grid-column: 1 / -1;
      order: 3;
      justify-content: flex-start;
      overflow-x: auto;
      padding-bottom: 0.1rem;
    }
  }
</style>
