---
import type { BlogPost } from "@/lib/posts";
import { formatDate, getPostHref, getPostSummary, getReadingTime } from "@/lib/posts";
import { localizePath, type Locale } from "@/i18n/config";

interface Props {
  post: BlogPost;
  locale: Locale;
  featured?: boolean;
}

const { post, locale, featured = false } = Astro.props;
const hasCover = Boolean(post.data.cover);
const summary = getPostSummary(post);
---

<article class:list={["post-card", "glass", { featured, "without-cover": !hasCover }]}>
  {post.data.cover && (
    <a class="cover" href={getPostHref(post)} aria-label={post.data.title}>
      <img src={post.data.cover.src} alt={post.data.cover.alt} loading="lazy" />
    </a>
  )}
  <div class="content">
    <div class="meta">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, locale)}</time>
      {post.data.tags[0] && <a class="tag" href={localizePath(locale, `/tags/${post.data.tags[0].toLowerCase()}/`)}>{post.data.tags[0]}</a>}
    </div>
    <h3><a href={getPostHref(post)}>{post.data.title}</a></h3>
    <p>{summary}</p>
    <div class="foot">
      <span>{getReadingTime(post.body, locale)}</span>
      <a aria-label={`Read ${post.data.title}`} href={getPostHref(post)}>→</a>
    </div>
  </div>
</article>

<style>
  .post-card {
    display: grid;
    grid-template-columns: 190px 1fr;
    gap: 1rem;
    border-radius: var(--radius-md);
    padding: 0.62rem;
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .post-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--primary) 38%, var(--border));
  }

  .post-card.without-cover {
    grid-template-columns: 1fr;
  }

  .cover {
    overflow: hidden;
    border-radius: calc(var(--radius-md) - 7px);
    background: var(--tag);
  }

  .cover img {
    width: 100%;
    height: 100%;
    min-height: 132px;
    object-fit: cover;
  }

  .content {
    display: grid;
    gap: 0.5rem;
    padding: 0.55rem 0.6rem 0.55rem 0;
  }

  .without-cover .content {
    padding-left: 0.6rem;
  }

  .meta,
  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    color: var(--muted);
    font-size: 0.84rem;
  }

  .tag {
    border-radius: 999px;
    background: var(--tag);
    color: var(--primary);
    padding: 0.26rem 0.58rem;
  }

  h3,
  p {
    margin: 0;
  }

  h3 {
    font-size: 1.05rem;
    line-height: 1.35;
  }

  h3 a:hover {
    color: var(--primary);
  }

  p {
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.6;
  }

  .foot a {
    color: var(--primary);
    font-size: 1.15rem;
  }

  @media (max-width: 680px) {
    .post-card {
      grid-template-columns: 1fr;
    }

    .content {
      padding: 0.35rem;
    }

    .cover img {
      max-height: 190px;
    }
  }
</style>
