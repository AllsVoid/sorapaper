---
import { ui } from "@/i18n/ui";
import { withBase } from "@/lib/paths";
---

<dialog class="search-dialog glass" data-search-dialog>
  <form method="dialog">
    <button type="submit" aria-label="Close search">×</button>
  </form>
  <label>
    <span>
      <span data-lang="zh">{ui.zh.search.label}</span>
      <span data-lang="en">{ui.en.search.label}</span>
    </span>
    <input type="search" placeholder={ui.zh.search.placeholder} data-search-input data-placeholder-zh={ui.zh.search.placeholder} data-placeholder-en={ui.en.search.placeholder} />
  </label>
  <div class="results" data-search-results>
    <p class="muted">
      <span data-lang="zh">{ui.zh.search.empty}</span>
      <span data-lang="en">{ui.en.search.empty}</span>
    </p>
  </div>
</dialog>

<script is:inline define:vars={{ searchIndexPath: withBase("/search.json"), emptyTextZh: ui.zh.search.empty, emptyTextEn: ui.en.search.empty, noResultsTextZh: ui.zh.search.noResults, noResultsTextEn: ui.en.search.noResults }}>
  const dialog = document.querySelector("[data-search-dialog]");
  const input = document.querySelector("[data-search-input]");
  const results = document.querySelector("[data-search-results]");
  const triggers = document.querySelectorAll("[data-search-trigger]");
  let index = [];

  const getCurrentLocale = () => (document.documentElement.dataset.locale === "en" ? "en" : "zh");
  const getCopy = () => {
    const locale = getCurrentLocale();
    return {
      emptyText: locale === "en" ? emptyTextEn : emptyTextZh,
      noResultsText: locale === "en" ? noResultsTextEn : noResultsTextZh
    };
  };

  const render = (items) => {
    if (!results) return;
    const { emptyText, noResultsText } = getCopy();
    if (!input?.value.trim()) {
      results.innerHTML = `<p class="muted">${emptyText}</p>`;
      return;
    }
    if (items.length === 0) {
      results.innerHTML = `<p class="muted">${noResultsText}</p>`;
      return;
    }
    results.innerHTML = items
      .map(
        (item) => `
          <a class="result" href="${item.href}">
            <strong>${item.title}</strong>
            <span>${item.description}</span>
          </a>
        `
      )
      .join("");
  };

  const loadIndex = async () => {
    if (index.length > 0) return;
    const response = await fetch(searchIndexPath);
    index = await response.json();
  };

  triggers.forEach((trigger) => {
    trigger.addEventListener("click", async () => {
      await loadIndex();
      const locale = getCurrentLocale();
      if (input) input.placeholder = locale === "en" ? input.dataset.placeholderEn ?? "" : input.dataset.placeholderZh ?? "";
      render([]);
      dialog?.showModal();
      input?.focus();
    });
  });

  input?.addEventListener("input", () => {
    const query = input.value.trim().toLowerCase();
    const currentLocale = getCurrentLocale();
    const matches = index
      .filter((item) => item.lang === currentLocale)
      .filter((item) => [item.title, item.description, item.tags.join(" ")].join(" ").toLowerCase().includes(query))
      .slice(0, 8);
    render(matches);
  });
</script>

<style>
  .search-dialog {
    width: min(92vw, 680px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    color: var(--text);
    padding: 1rem;
  }

  .search-dialog::backdrop {
    background: rgba(20, 24, 40, 0.36);
    backdrop-filter: blur(8px);
  }

  form {
    display: flex;
    justify-content: flex-end;
  }

  button {
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 999px;
    background: var(--tag);
    color: var(--text);
    cursor: pointer;
  }

  label {
    display: grid;
    gap: 0.65rem;
    font-weight: 700;
  }

  input {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-strong);
    color: var(--text);
    outline: none;
    padding: 0.95rem 1rem;
  }

  input:focus {
    border-color: var(--primary);
  }

  .results {
    display: grid;
    gap: 0.6rem;
    margin-top: 1rem;
  }

  :global(.result) {
    display: grid;
    gap: 0.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-strong);
    padding: 0.85rem;
  }

  :global(.result span) {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }
</style>
