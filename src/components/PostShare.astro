---
import { themeConfig } from "@/config/theme";
import { getUi } from "@/i18n/ui";
import type { Locale } from "@/i18n/config";
import type { BlogPost } from "@/lib/posts";
import { getPostHref, getPostOgImageHref, getPostOgImagePngHref, getPostSummary, getPostSlug } from "@/lib/posts";

interface Props {
  post: BlogPost;
  locale: Locale;
}

const { post, locale } = Astro.props;
const t = getUi(locale).article;
const siteUrl = themeConfig.site.url.endsWith("/") ? themeConfig.site.url : `${themeConfig.site.url}/`;
const svgPath = getPostOgImageHref(post);
const pngPath = getPostOgImagePngHref(post);
const postUrl = new URL(getPostHref(post), siteUrl).toString();
const shareImageUrl = new URL(post.data.ogImage ?? pngPath, siteUrl).toString();
const shareText = `${post.data.title} · ${themeConfig.name}`;
const shareSummary = getPostSummary(post);
const fileName = `sorapaper-${getPostSlug(post)}`;
const xUrl = `https://x.com/intent/post?${new URLSearchParams({ url: postUrl, text: shareText })}`;
const telegramUrl = `https://t.me/share/url?${new URLSearchParams({ url: postUrl, text: shareText })}`;
const weiboUrl = `https://service.weibo.com/share/share.php?${new URLSearchParams({
  url: postUrl,
  title: `${shareText}\n${shareSummary}`,
  pic: shareImageUrl
})}`;
---

<div
  class="post-share"
  data-post-share
  data-url={postUrl}
  data-title={shareText}
  data-text={shareSummary}
  data-png={pngPath}
  data-filename={fileName}
>
  <button class="share-trigger" type="button" data-share-trigger aria-expanded="false" aria-label={t.share}>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M7.8 12.2 15.9 7M7.8 11.8l8.1 5.2M6.2 15.8a3.1 3.1 0 1 0 0-6.2 3.1 3.1 0 0 0 0 6.2ZM18 8.8a3.1 3.1 0 1 0 0-6.2 3.1 3.1 0 0 0 0 6.2ZM18 21.4a3.1 3.1 0 1 0 0-6.2 3.1 3.1 0 0 0 0 6.2Z" />
    </svg>
    <span>{t.share}</span>
  </button>
  <div class="share-panel glass">
    <p>{t.shareDescription}</p>
    <div class="share-actions">
      <button type="button" data-copy-link data-copy-label={t.copyLink} data-copied-label={t.copied}>{t.copyLink}</button>
      <button type="button" data-native-share>{t.nativeShare}</button>
      <a href={svgPath} download={`${fileName}.svg`}>{t.downloadSvg}</a>
      <a href={pngPath} download={`${fileName}.png`}>{t.downloadPng}</a>
      <a href={xUrl} target="_blank" rel="noreferrer">{t.shareToX}</a>
      <a href={weiboUrl} target="_blank" rel="noreferrer">{t.shareToWeibo}</a>
      <a href={telegramUrl} target="_blank" rel="noreferrer">{t.shareToTelegram}</a>
    </div>
    <div class="wechat-share">
      <div class="qr-frame">
        <canvas width="168" height="168" data-wechat-qr aria-label={t.wechat}></canvas>
      </div>
      <div>
        <strong>{t.wechat}</strong>
        <span>{t.wechatHint}</span>
      </div>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll("[data-post-share]").forEach((share) => {
    if (!(share instanceof HTMLElement)) return;

    const url = share.dataset.url ?? window.location.href;
    const title = share.dataset.title ?? document.title;
    const text = share.dataset.text ?? "";
    const pngUrl = share.dataset.png ?? "";
    const fileName = share.dataset.filename ?? "sorapaper-share";
    const trigger = share.querySelector("[data-share-trigger]");
    const copyButton = share.querySelector("[data-copy-link]");
    const nativeButton = share.querySelector("[data-native-share]");
    const canvas = share.querySelector("[data-wechat-qr]");
    let qrRendered = false;

    async function renderQr() {
      if (qrRendered || !(canvas instanceof HTMLCanvasElement)) return;
      qrRendered = true;
      const { default: QRCode } = await import("qrcode");
      await QRCode.toCanvas(canvas, url, {
        width: 168,
        margin: 1,
        color: {
          dark: "#27304a",
          light: "#ffffff"
        }
      });
    }

    function setOpen(open: boolean) {
      share.toggleAttribute("data-open", open);
      if (trigger instanceof HTMLButtonElement) {
        trigger.setAttribute("aria-expanded", String(open));
      }
      if (open) renderQr();
    }

    trigger?.addEventListener("click", (event) => {
      event.stopPropagation();
      setOpen(!share.hasAttribute("data-open"));
    });

    share.addEventListener("pointerenter", () => renderQr());
    share.addEventListener("focusin", () => renderQr());

    document.addEventListener("click", (event) => {
      if (event.target instanceof Node && !share.contains(event.target)) setOpen(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });

    copyButton?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(url);
        copyButton.textContent = copyButton.getAttribute("data-copied-label") ?? "";
        window.setTimeout(() => {
          copyButton.textContent = copyButton.getAttribute("data-copy-label") ?? "";
        }, 1400);
      } catch {
        copyButton.textContent = url;
      }
    });

    nativeButton?.addEventListener("click", async () => {
      try {
        if (!navigator.share) {
          await navigator.clipboard.writeText(url);
          return;
        }

        if (pngUrl && navigator.canShare) {
          const response = await fetch(pngUrl);
          const blob = await response.blob();
          const file = new File([blob], `${fileName}.png`, { type: "image/png" });
          const data = { files: [file], title, text, url };
          if (navigator.canShare({ files: [file] })) {
            await navigator.share(data);
            return;
          }
        }

        await navigator.share({ title, text, url });
      } catch (error) {
        if (!(error instanceof DOMException) || error.name !== "AbortError") {
          await navigator.clipboard.writeText(url);
        }
      }
    });
  });
</script>

<style>
  .post-share {
    position: relative;
    z-index: 30;
    display: inline-flex;
  }

  .share-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.34rem;
    border: 1px solid color-mix(in srgb, var(--primary) 28%, var(--border));
    border-radius: 999px;
    background: color-mix(in srgb, var(--primary) 8%, var(--surface));
    color: var(--primary);
    cursor: pointer;
    padding: 0.32rem 0.58rem;
    font-size: 0.86rem;
    font-weight: 700;
    line-height: 1;
  }

  svg {
    width: 1.08em;
    height: 1.08em;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.75;
  }

  .share-trigger:hover,
  .share-trigger:focus-visible {
    border-color: color-mix(in srgb, var(--primary) 52%, var(--border));
    background: color-mix(in srgb, var(--primary) 14%, var(--surface-strong));
  }

  .share-panel {
    position: absolute;
    top: calc(100% + 0.55rem);
    right: 0;
    width: min(26rem, calc(100vw - 2rem));
    border-radius: var(--radius-lg);
    padding: 0.95rem;
    opacity: 0;
    pointer-events: none;
    transform: translateY(0.35rem);
    transition: opacity 160ms ease, transform 160ms ease, visibility 160ms ease;
    visibility: hidden;
  }

  .post-share:hover .share-panel,
  .post-share:focus-within .share-panel,
  .post-share[data-open] .share-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
    visibility: visible;
  }

  .share-panel p {
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .share-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .share-actions a,
  .share-actions button {
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface-strong);
    color: var(--text);
    cursor: pointer;
    padding: 0.48rem 0.7rem;
    font-size: 0.86rem;
    line-height: 1.2;
  }

  .share-actions a:hover,
  .share-actions button:hover {
    border-color: color-mix(in srgb, var(--primary) 42%, var(--border));
    color: var(--primary);
  }

  .wechat-share {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem;
    align-items: center;
    margin-top: 0.8rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--surface-strong) 88%, transparent);
    padding: 0.72rem;
  }

  .qr-frame {
    border-radius: 16px;
    background: #fff;
    padding: 0.35rem;
  }

  canvas {
    display: block;
    width: 7rem;
    height: 7rem;
  }

  .wechat-share strong,
  .wechat-share span {
    display: block;
  }

  .wechat-share strong {
    margin-bottom: 0.35rem;
    color: var(--text);
  }

  .wechat-share span {
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.65;
  }

  @media (max-width: 560px) {
    .share-panel {
      right: auto;
      left: 50%;
      width: calc(100vw - 2rem);
      transform: translateX(-50%) translateY(0.35rem);
    }

    .post-share:hover .share-panel,
    .post-share:focus-within .share-panel,
    .post-share[data-open] .share-panel {
      transform: translateX(-50%) translateY(0);
    }

    .wechat-share {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }
  }
</style>
