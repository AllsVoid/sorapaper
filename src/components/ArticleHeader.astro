---
import type { BlogPost } from "@/lib/posts";
import { formatDate, getReadingTime } from "@/lib/posts";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<header class="article-header">
  <a class="back" href="/">← Back</a>
  <div class="inner">
    <div class="tags">
      {post.data.tags.map((tag) => <a class="pill" href={`/tags/${encodeURIComponent(tag.toLowerCase())}/`}>{tag}</a>)}
    </div>
    <h1>{post.data.title}</h1>
    <p>{post.data.description}</p>
    <div class="meta">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      <span>{getReadingTime(post.body)}</span>
      {post.data.updatedDate && <span>Updated {formatDate(post.data.updatedDate)}</span>}
    </div>
  </div>
</header>

<style>
  .article-header {
    padding: 3.4rem 0 2rem;
  }

  .back {
    display: inline-flex;
    margin-bottom: 1.8rem;
    color: var(--muted);
    font-size: 0.94rem;
  }

  .back:hover {
    color: var(--primary);
  }

  .inner {
    width: min(100%, var(--article));
    margin-inline: auto;
  }

  .tags,
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  h1 {
    margin: 1rem 0 0.7rem;
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 6vw, 4.6rem);
    letter-spacing: -0.06em;
    line-height: 1.04;
  }

  p {
    margin: 0;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.75;
  }

  .meta {
    margin-top: 1.1rem;
    color: var(--muted);
    font-size: 0.92rem;
  }
</style>
