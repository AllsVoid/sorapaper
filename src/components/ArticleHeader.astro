---
import type { BlogPost } from "@/lib/posts";
import { formatDate, getPostSummary, getReadingTime } from "@/lib/posts";
import { localizePath, type Locale } from "@/i18n/config";
import { getUi } from "@/i18n/ui";

interface Props {
  post: BlogPost;
  locale: Locale;
}

const { post, locale } = Astro.props;
const t = getUi(locale);
const summary = getPostSummary(post);
---

<header class="article-header">
  <a class="back" href={localizePath(locale)}>← {t.article.back}</a>
  <div class="inner">
    <div class="tags">
      {post.data.tags.map((tag) => <a class="pill" href={localizePath(locale, `/tags/${tag.toLowerCase()}/`)}>{tag}</a>)}
    </div>
    <h1>{post.data.title}</h1>
    <p>{summary}</p>
    <div class="meta">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, locale)}</time>
      <span>{getReadingTime(post.body, locale)}</span>
      {post.data.updatedDate && <span>{t.article.updated} {formatDate(post.data.updatedDate, locale)}</span>}
    </div>
  </div>
</header>

<style>
  .article-header {
    padding: 3.4rem 0 2rem;
  }

  .back {
    display: inline-flex;
    margin-bottom: 1.8rem;
    color: var(--muted);
    font-size: 0.94rem;
  }

  .back:hover {
    color: var(--primary);
  }

  .inner {
    width: min(100%, var(--article));
    margin-inline: auto;
  }

  .tags,
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  h1 {
    margin: 1rem 0 0.7rem;
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 5.2vw, 5rem);
    letter-spacing: 0;
    line-height: 1.12;
  }

  p {
    margin: 0;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.75;
  }

  .meta {
    margin-top: 1.1rem;
    color: var(--muted);
    font-size: 0.92rem;
  }
</style>
