---
import { themeConfig } from "@/config/theme";
import { ui } from "@/i18n/ui";

---

<footer class="site-footer container">
  <p>
    © {new Date().getFullYear()} {themeConfig.name}.
    <span data-lang="zh">{ui.zh.footer.builtWith}</span>
    <span data-lang="en">{ui.en.footer.builtWith}</span>
  </p>
</footer>

<style is:global>
  .site-footer {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    color: var(--muted);
    font-size: 0.92rem;
    padding: 3rem 0 2rem;
    text-align: center;
  }
</style>
