---
import { themeConfig } from "@/config/theme";
import { localizePath, type Locale } from "@/i18n/config";
import { ui } from "@/i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<footer class="site-footer container">
  <p>
    © {new Date().getFullYear()} {themeConfig.name}.
    <span data-lang="zh">{ui.zh.footer.builtWith}</span>
    <span data-lang="en">{ui.en.footer.builtWith}</span>
  </p>
  <div>
    <a href={localizePath(locale, "/rss.xml")}>RSS</a>
    <span aria-hidden="true">·</span>
    <a href={localizePath(locale, "/about/")}>
      <span data-lang="zh">{ui.zh.nav.about}</span>
      <span data-lang="en">{ui.en.nav.about}</span>
    </a>
  </div>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    color: var(--muted);
    font-size: 0.92rem;
    padding: 3rem 0 2rem;
    text-align: center;
  }

  .site-footer div {
    display: flex;
    gap: 0.5rem;
  }

  .site-footer a:hover {
    color: var(--primary);
  }
</style>
