---
import mapData from "@/data/maps/china-admin.json";
import taiwanCityData from "@/data/maps/taiwan-cities.json";
import japanMapData from "@/data/maps/japan-admin2.json";
import { getTravelHref, type TravelEntry } from "@/lib/travel";

interface Props { travels: TravelEntry[]; }
interface MapFeature { id: string; pid: string; level: number; name: string; polygons: number[][][]; }
interface Bounds { minLng: number; maxLng: number; minLat: number; maxLat: number; }
interface TravelPreview { href: string; title: string; description: string; place: string; }
interface SpecialRegion { name: string; feature: MapFeature; viewBox: string; }

const { travels } = Astro.props;
const features = [...mapData.features, ...taiwanCityData.features, ...japanMapData.features] as MapFeature[];
const allProvinces = features.filter((feature) => feature.level === 0 && !["81", "82"].includes(feature.id));
const citiesByProvince = new Map(allProvinces.map((province) => [province.id, features.filter((feature) => feature.level === 1 && feature.pid === province.id)]));
const cityLinks = new Map<string, string>();
const cityPreviews = new Map<string, TravelPreview>();
const destinationMarkers: { name: string; href: string; coordinates: [number, number] }[] = [];
const mapOverviewItems = travels.flatMap((travel) => travel.data.destinations
  .map((destination) => ({
    href: getTravelHref(travel),
    place: destination.province ? `${destination.province} · ${destination.name}` : destination.name,
    country: destination.country,
    title: travel.data.title,
    description: destination.summary ?? travel.data.description
  })));
for (const travel of travels) {
  for (const destination of travel.data.destinations) {
    const code = destination.country === "JP" ? destination.adminCode : destination.adminCode?.replace(/00$/, "");
    if (code) {
      const href = getTravelHref(travel);
      cityLinks.set(code, href);
      cityPreviews.set(code, { href, title: travel.data.title, description: travel.data.description, place: destination.name });
    }
    if (destination.coordinates) destinationMarkers.push({ name: destination.name, href: getTravelHref(travel), coordinates: destination.coordinates });
  }
}

const visitedCityIds = new Set(cityLinks.keys());
const specialRegionIds = new Set(["8100", "8200"]);
const specialRegions = features.flatMap((feature) => {
  const preview = cityPreviews.get(feature.id);
  if (!specialRegionIds.has(feature.id) || !preview) return [];
  const featureBounds = getDetailBounds(feature.polygons.flat());
  return [{ name: getCityLabel(feature.name), feature, viewBox: `${featureBounds.minLng} ${-featureBounds.maxLat} ${featureBounds.maxLng - featureBounds.minLng} ${featureBounds.maxLat - featureBounds.minLat}` } satisfies SpecialRegion];
});
const visitedProvinceIds = new Set(features.filter((feature) => feature.level === 1 && visitedCityIds.has(feature.id) && !specialRegionIds.has(feature.id)).map((feature) => feature.pid));
const chinaProvinces = allProvinces.filter((province) => !province.id.startsWith("JP-"));
const japanProvinces = allProvinces.filter((province) => province.id.startsWith("JP-"));
const visitedChinaProvinces = chinaProvinces.filter((province) => visitedProvinceIds.has(province.id));
const visitedJapanProvinces = japanProvinces.filter((province) => visitedProvinceIds.has(province.id));
const visitedChinaBounds = getRawBounds(visitedChinaProvinces.flatMap((province) => province.polygons.flatMap((ring) => ring)));
const chinaVisibleProvinces = visitedChinaProvinces.length < 2 ? visitedChinaProvinces : chinaProvinces.filter((province) => intersects(getRawBounds(province.polygons.flat()), visitedChinaBounds));
const visitedJapanBounds = getRawBounds(visitedJapanProvinces.flatMap((province) => province.polygons.flatMap((ring) => ring)));
const japanContextBounds = getContextBounds(visitedJapanBounds);
const japanVisibleProvinces = visitedJapanProvinces.length === 0 ? [] : japanProvinces.filter((province) => intersects(getRawBounds(province.polygons.flat()), japanContextBounds));
const provinces = [...chinaVisibleProvinces, ...japanVisibleProvinces];
const visibleFeatures = [...provinces, ...provinces.flatMap((province) => citiesByProvince.get(province.id) ?? [])];
const points = [
  ...visibleFeatures.flatMap((feature) => feature.polygons.flatMap((ring) => ring)),
  ...specialRegions.flatMap((region) => region.feature.polygons.flat()),
  ...destinationMarkers.map((marker) => marker.coordinates)
];
function getProvincePreview(provinceId: string) {
  return (citiesByProvince.get(provinceId) ?? []).map((city) => cityPreviews.get(city.id)).find(Boolean);
}

function getRawBounds(coordinates: number[][]): Bounds {
  const fallback = { minLng: 73, maxLng: 135, minLat: 18, maxLat: 54 };
  if (!coordinates.length) return fallback;
  let minLng = Infinity;
  let maxLng = -Infinity;
  let minLat = Infinity;
  let maxLat = -Infinity;
  for (const [lng, lat] of coordinates) {
    minLng = Math.min(minLng, lng);
    maxLng = Math.max(maxLng, lng);
    minLat = Math.min(minLat, lat);
    maxLat = Math.max(maxLat, lat);
  }
  return { minLng, maxLng, minLat, maxLat };
}
function getBounds(coordinates: number[][]): Bounds {
  const raw = getRawBounds(coordinates);
  const spanLng = Math.max(raw.maxLng - raw.minLng, 1.2);
  const spanLat = Math.max(raw.maxLat - raw.minLat, 1.2);
  const padding = Math.max(spanLng, spanLat) * 0.09;
  return { minLng: raw.minLng - padding, maxLng: raw.maxLng + padding, minLat: raw.minLat - padding, maxLat: raw.maxLat + padding };
}
function getContextBounds(bounds: Bounds): Bounds {
  const span = Math.max(bounds.maxLng - bounds.minLng, bounds.maxLat - bounds.minLat, 1.2);
  const padding = Math.min(Math.max(span * .45, .8), 2.2);
  return { minLng: bounds.minLng - padding, maxLng: bounds.maxLng + padding, minLat: bounds.minLat - padding, maxLat: bounds.maxLat + padding };
}
function intersects(a: Bounds, b: Bounds) { return a.minLng <= b.maxLng && a.maxLng >= b.minLng && a.minLat <= b.maxLat && a.maxLat >= b.minLat; }
function getDetailBounds(coordinates: number[][]): Bounds {
  const raw = getRawBounds(coordinates);
  // Hong Kong and Macao include scattered islands. A tight crop makes their
  // outlines fill the entire canvas, so retain a regional amount of context.
  const spanLng = Math.max(raw.maxLng - raw.minLng, 4);
  const spanLat = Math.max(raw.maxLat - raw.minLat, 3);
  const padding = Math.max(spanLng, spanLat) * .09;
  return { minLng: raw.minLng - padding, maxLng: raw.maxLng + padding, minLat: raw.minLat - padding, maxLat: raw.maxLat + padding };
}
const bounds = getBounds(points);
const viewBox = `${bounds.minLng} ${-bounds.maxLat} ${bounds.maxLng - bounds.minLng} ${bounds.maxLat - bounds.minLat}`;
function point([lng, lat]: number[]) { return `${lng} ${-lat}`; }
function ringArea(ring: number[][]) {
  return ring.reduce((area, [x, y], index) => {
    const [nextX, nextY] = ring[(index + 1) % ring.length];
    return area + x * nextY - nextX * y;
  }, 0) / 2;
}
function labelPoint(feature: MapFeature) {
  const ring = feature.polygons.reduce((largest, candidate) => Math.abs(ringArea(candidate)) > Math.abs(ringArea(largest)) ? candidate : largest, feature.polygons[0]);
  const area = ringArea(ring);
  if (!area) {
    const featureBounds = getRawBounds(ring);
    return [(featureBounds.minLng + featureBounds.maxLng) / 2, -(featureBounds.minLat + featureBounds.maxLat) / 2] as const;
  }
  const [x, y] = ring.reduce(([sumX, sumY], [currentX, currentY], index) => {
    const [nextX, nextY] = ring[(index + 1) % ring.length];
    const cross = currentX * nextY - nextX * currentY;
    return [sumX + (currentX + nextX) * cross, sumY + (currentY + nextY) * cross];
  }, [0, 0]);
  return [x / (6 * area), -y / (6 * area)] as const;
}
function getCityLabel(name: string) {
  const shortened = name.replace("香港特别行政区", "香港").replace("澳门特别行政区", "澳门");
  return ["省", "市", "县"].includes(shortened.at(-1) ?? "") ? shortened.slice(0, -1) : shortened;
}
function path(feature: MapFeature) {
  return feature.polygons.map((ring) => ring.map((coordinates, index) => `${index ? "L" : "M"}${point(coordinates)}`).join("") + "Z").join("");
}
---

<section class="travel-map" data-travel-map aria-label="Travel map">
  <div class="map-stage">
    <div class="map-key" aria-label="Map legend"><span class="key-province"></span><span data-lang="zh">有游记的省份</span><span data-lang="en">Province with travel</span></div>
    <div class="map-controls" aria-label="Map controls">
      <button type="button" data-map-overview aria-expanded="false" aria-controls="travel-map-overview"><span data-lang="zh">全部信息</span><span data-lang="en">All info</span></button>
      <button type="button" data-map-zoom-in aria-label="Zoom in"><span data-lang="zh">放大</span><span data-lang="en">Zoom in</span></button>
      <button type="button" data-map-zoom-out aria-label="Zoom out"><span data-lang="zh">缩小</span><span data-lang="en">Zoom out</span></button>
      <button type="button" data-map-zoom-reset><span data-lang="zh">复位</span><span data-lang="en">Reset</span></button>
    </div>
    <svg viewBox={viewBox} role="group" aria-label="Travel destinations map. Drag or use arrow keys to pan." preserveAspectRatio="xMidYMid meet" tabindex="0" data-map-canvas>
    <g class="provinces">
      {provinces.map((province) => {
        const cities = citiesByProvince.get(province.id) ?? [];
        const [labelX, labelY] = labelPoint(province);
        const preview = getProvincePreview(province.id);
        return <g class:list={["province", { "is-visited": visitedProvinceIds.has(province.id) }]} data-province data-province-preview={preview ? "" : undefined} data-preview-title={preview?.title} data-preview-description={preview?.description} data-preview-place={preview?.place} data-preview-href={preview?.href}>
          <path class="province-shape" d={path(province)} fill-rule="evenodd" tabindex="0" role="button" aria-label={`Show ${province.name} cities`} aria-expanded="false" />
          <text class="province-label" x={labelX} y={labelY}>{province.name.replace(/(省|市|自治区|特别行政区)$/, "")}</text>
          <g class="cities" aria-hidden="true">
            {cities.map((city) => {
              const [cityX, cityY] = labelPoint(city);
              const preview = cityPreviews.get(city.id);
              return preview ? (
                <a class="city-region" href={preview.href} aria-label={city.name} data-city-region data-city-preview data-preview-title={preview.title} data-preview-description={preview.description} data-preview-place={preview.place} data-preview-href={preview.href}><path class="city visited" d={path(city)} fill-rule="evenodd" /><text class="city-label" x={cityX} y={cityY}>{preview.place || getCityLabel(city.name)}</text></a>
              ) : <g class="city-region" data-city-region tabindex="0" role="button" aria-label={city.name}><path class="city" d={path(city)} fill-rule="evenodd" /><text class="city-label" x={cityX} y={cityY}>{getCityLabel(city.name)}</text></g>;
            })}
          </g>
        </g>;
      })}
    </g>
    {specialRegions.length > 0 && <g class="special-region-shapes">
      {specialRegions.map((region) => {
        const [labelX, labelY] = labelPoint(region.feature);
        return <g class="special-region-shape" data-special-region-shape={region.feature.id} aria-hidden="true"><path d={path(region.feature)} /><text class="special-region-label" x={labelX} y={labelY}>{region.name}</text></g>;
      })}
    </g>}
    <g class="markers">
      {destinationMarkers.map((marker) => <a href={marker.href} aria-label={marker.name}><circle class="destination-marker" cx={marker.coordinates[0]} cy={-marker.coordinates[1]} r="0.18" /></a>)}
    </g>
    {specialRegions.length > 0 && <g class="special-region-markers">
      {specialRegions.map((region, index) => {
        const [x, y] = labelPoint(region.feature);
        const markerX = x + (index ? 2.2 : -2.2);
        const markerY = y + (index ? -1.1 : 1.1);
        return <g class="special-region-marker" data-special-region data-region-id={region.feature.id} data-region-view-box={region.viewBox} tabindex="0" role="button" aria-label={`Show ${region.name} travel`}>
          <line x1={x} y1={y} x2={markerX} y2={markerY} />
          <circle cx={markerX} cy={markerY} r=".46" />
          <text x={markerX} y={markerY + .1}>{region.name}</text>
        </g>;
      })}
    </g>}
    </svg>
    <article class="map-preview glass" data-map-preview aria-live="polite">
      <p data-preview-place></p>
      <h2 data-preview-title></h2>
      <p class="preview-description" data-preview-description></p>
      <a data-preview-link><span data-lang="zh">阅读游记</span><span data-lang="en">Read travel</span> →</a>
    </article>
    <aside class="map-overview glass" id="travel-map-overview" data-map-overview-panel aria-live="polite">
      <h2><span data-lang="zh">地图中的全部游记</span><span data-lang="en">All map entries</span></h2>
      <ul>
        {mapOverviewItems.map((item) => <li><p class="overview-place">{item.place} · {item.country}</p><h3><a href={item.href}>{item.title}</a></h3><p>{item.description}</p></li>)}
      </ul>
    </aside>
  </div>
  <ul class="destination-list" aria-label="Travel destinations">
    {travels.flatMap((travel) => travel.data.destinations.map((destination) => <li><a href={getTravelHref(travel)}>{destination.name}</a><span>{destination.country}</span></li>))}
  </ul>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-travel-map]").forEach((map) => {
    const stage = map.querySelector<HTMLElement>(".map-stage");
    const preview = map.querySelector<HTMLElement>("[data-map-preview]");
    const previewPlace = preview?.querySelector<HTMLElement>("[data-preview-place]");
    const previewTitle = preview?.querySelector<HTMLElement>("[data-preview-title]");
    const previewDescription = preview?.querySelector<HTMLElement>("[data-preview-description]");
    const previewLink = preview?.querySelector<HTMLAnchorElement>("[data-preview-link]");
    const overviewButton = map.querySelector<HTMLButtonElement>("[data-map-overview]");
    const svg = map.querySelector<SVGSVGElement>("[data-map-canvas]");
    if (!svg) return;
    const initial = svg.viewBox.baseVal;
    const original = { x: initial.x, y: initial.y, width: initial.width, height: initial.height };
    const initialViewBox = svg.getAttribute("viewBox") ?? "";
    const specialRegionShapes = [...map.querySelectorAll<SVGGElement>("[data-special-region-shape]")];
    let specialRegionOpen = false;
    const hideSpecialRegions = () => {
      specialRegionOpen = false;
      specialRegionShapes.forEach((shape) => { shape.classList.remove("is-open"); shape.setAttribute("aria-hidden", "true"); });
      svg.setAttribute("viewBox", initialViewBox);
    };
    const showPreview = (source: DOMStringMap) => {
      if (!preview || !source.previewHref) return;
      if (previewPlace) previewPlace.textContent = source.previewPlace ?? "";
      if (previewTitle) previewTitle.textContent = source.previewTitle ?? "";
      if (previewDescription) previewDescription.textContent = source.previewDescription ?? "";
      if (previewLink) previewLink.href = source.previewHref;
      stage?.classList.remove("is-overview-open");
      overviewButton?.setAttribute("aria-expanded", "false");
      stage?.classList.add("is-preview-open");
    };
    const specialRegions = [...map.querySelectorAll<HTMLElement>("[data-special-region]")];
    specialRegions.forEach((region) => {
      const open = () => {
        specialRegionOpen = true;
        specialRegions.forEach((item) => item.classList.toggle("is-active", item === region));
        specialRegionShapes.forEach((shape) => {
          const active = shape.dataset.specialRegionShape === region.dataset.regionId;
          shape.classList.toggle("is-open", active);
          shape.setAttribute("aria-hidden", String(!active));
        });
        if (region.dataset.regionViewBox) svg.setAttribute("viewBox", region.dataset.regionViewBox);
      };
      region.addEventListener("mouseenter", open);
      region.addEventListener("focus", open);
      region.addEventListener("click", open);
      region.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") { event.preventDefault(); open(); }
      });
    });
    const provinces = [...map.querySelectorAll<HTMLElement>("[data-province]")];
    const provinceLayer = map.querySelector<SVGGElement>(".provinces");
    provinces.forEach((province) => {
      const open = (showArticle = false) => {
        provinces.forEach((item) => {
          const active = item === province;
          item.classList.toggle("is-open", active);
          item.querySelector<SVGPathElement>(".province-shape")?.setAttribute("aria-expanded", String(active));
          item.querySelector<SVGGElement>(".cities")?.setAttribute("aria-hidden", String(!active));
        });
        provinceLayer?.append(province);
        map.classList.add("is-province-open");
        hideSpecialRegions();
        specialRegions.forEach((item) => item.classList.remove("is-active"));
        if (showArticle && province.dataset.provincePreview !== undefined) showPreview(province.dataset);
      };
      province.addEventListener("mouseenter", () => open());
      province.addEventListener("focus", () => open());
      province.addEventListener("click", () => open(true));
      province.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") { event.preventDefault(); open(true); }
      });
    });

    const cityRegions = [...map.querySelectorAll<HTMLElement>("[data-city-region]")];
    cityRegions.forEach((city) => {
      const activate = () => {
        cityRegions.forEach((item) => item.classList.toggle("is-active", item === city));
        hideSpecialRegions();
        specialRegions.forEach((item) => item.classList.remove("is-active"));
        if (stage?.classList.contains("is-preview-open") && city.dataset.cityPreview !== undefined) showPreview(city.dataset);
      };
      city.addEventListener("mouseenter", activate);
      city.addEventListener("focus", activate);
      city.addEventListener("click", activate);
    });

    const close = () => {
      provinces.forEach((province) => {
        province.classList.remove("is-open");
        province.querySelector<SVGPathElement>(".province-shape")?.setAttribute("aria-expanded", "false");
        province.querySelector<SVGGElement>(".cities")?.setAttribute("aria-hidden", "true");
      });
      cityRegions.forEach((city) => city.classList.remove("is-active"));
      specialRegions.forEach((region) => region.classList.remove("is-active"));
      hideSpecialRegions();
      map.classList.remove("is-province-open");
      stage?.classList.remove("is-preview-open");
    };
    overviewButton?.addEventListener("click", () => {
      const open = !stage?.classList.contains("is-overview-open");
      close();
      stage?.classList.toggle("is-overview-open", open);
      overviewButton.setAttribute("aria-expanded", String(open));
    });
    stage?.addEventListener("mouseleave", close);

    svg.addEventListener("pointermove", (event) => {
      const target = event.target;
      if (!specialRegionOpen && (!(target instanceof Element) || !target.closest("[data-province], [data-special-region]"))) close();
    });
    let zoom = 1;
    let centerX = original.x + original.width / 2;
    let centerY = original.y + original.height / 2;
    const updateViewBox = () => {
      const width = original.width / zoom;
      const height = original.height / zoom;
      svg.setAttribute("viewBox", `${centerX - width / 2} ${centerY - height / 2} ${width} ${height}`);
    };
    let dragStart: { x: number; y: number } | undefined;
    svg.addEventListener("pointerdown", (event) => { dragStart = { x: event.clientX, y: event.clientY }; svg.setPointerCapture(event.pointerId); });
    svg.addEventListener("pointermove", (event) => {
      if (!dragStart) return;
      const rect = svg.getBoundingClientRect();
      centerX -= (event.clientX - dragStart.x) * (original.width / zoom) / rect.width;
      centerY -= (event.clientY - dragStart.y) * (original.height / zoom) / rect.height;
      dragStart = { x: event.clientX, y: event.clientY };
      updateViewBox();
    });
    svg.addEventListener("pointerup", () => { dragStart = undefined; });
    svg.addEventListener("pointercancel", () => { dragStart = undefined; });
    svg.addEventListener("keydown", (event) => {
      const step = (event.shiftKey ? .3 : .12) / zoom;
      if (event.key === "ArrowLeft") centerX -= original.width * step;
      else if (event.key === "ArrowRight") centerX += original.width * step;
      else if (event.key === "ArrowUp") centerY -= original.height * step;
      else if (event.key === "ArrowDown") centerY += original.height * step;
      else return;
      event.preventDefault();
      updateViewBox();
    });
    map.querySelector<HTMLButtonElement>("[data-map-zoom-in]")?.addEventListener("click", () => { zoom = Math.min(zoom * 1.4, 5); updateViewBox(); });
    map.querySelector<HTMLButtonElement>("[data-map-zoom-out]")?.addEventListener("click", () => { zoom = Math.max(zoom / 1.4, 1); updateViewBox(); });
    map.querySelector<HTMLButtonElement>("[data-map-zoom-reset]")?.addEventListener("click", () => { zoom = 1; centerX = original.x + original.width / 2; centerY = original.y + original.height / 2; updateViewBox(); });
  });
</script>

<style>
  .travel-map { position: relative; width: 100%; padding: .75rem; border-radius: var(--radius-xl); } svg { display: block; width: 100%; min-height: 62vh; overflow: hidden; border: 1px solid color-mix(in srgb, var(--primary) 58%, var(--border)); border-radius: calc(var(--radius-xl) - .35rem); background: color-mix(in srgb, var(--bg-soft) 72%, transparent); backdrop-filter: blur(18px); cursor: grab; touch-action: none; } svg:active { cursor: grabbing; } .map-controls, .map-key { position: absolute; z-index: 1; display: flex; align-items: center; gap: .35rem; padding: .35rem; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface-strong); box-shadow: var(--shadow-soft); } .map-controls { top: 1.35rem; right: 1.35rem; } .map-key { top: 1.35rem; left: 1.35rem; color: var(--text); font-size: .82rem; } .key-province { width: .7rem; height: .7rem; border: 2px solid var(--text); border-radius: .18rem; background: color-mix(in srgb, var(--primary) 52%, var(--surface-strong)); } .map-controls button { min-width: 2.25rem; min-height: 2.25rem; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface-strong); color: var(--text); cursor: pointer; } .map-controls button:last-child { padding-inline: .55rem; } .province { cursor: pointer; } .province-shape { fill: color-mix(in srgb, var(--surface-strong) 84%, var(--primary)); stroke: color-mix(in srgb, var(--text) 72%, var(--primary)); stroke-width: 1.1; vector-effect: non-scaling-stroke; transition: fill .25s ease, filter .25s ease, opacity .25s ease; } .province.is-visited .province-shape { fill: color-mix(in srgb, var(--primary) 32%, var(--surface)); stroke: var(--text); stroke-width: 1.35; } .province:hover .province-shape, .province:focus-within .province-shape, .province.is-open .province-shape { fill: color-mix(in srgb, var(--primary) 48%, var(--surface)); filter: drop-shadow(0 .6rem .65rem color-mix(in srgb, var(--primary) 38%, transparent)); } .province-