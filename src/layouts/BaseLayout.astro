---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import ScrollProgress from "@/components/ScrollProgress.astro";
import { themeConfig } from "@/config/theme";
import { defaultLocale, type Locale } from "@/i18n/config";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  alternatePath?: string;
}

const {
  title = themeConfig.name,
  description = themeConfig.description,
  locale = defaultLocale,
  alternatePath
} = Astro.props;

const pageTitle = title === themeConfig.name ? title : `${title} · ${themeConfig.name}`;
---

<!doctype html>
<html lang={locale} data-locale={locale} data-scheme="paper">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <script is:inline>
      const theme = localStorage.getItem("theme");
      if (theme === "dark" || (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
        document.documentElement.dataset.theme = "dark";
      }
      const scheme = localStorage.getItem("scheme");
      if (scheme) document.documentElement.dataset.scheme = scheme;
      const queryLocale = new URLSearchParams(window.location.search).get("lang");
      const storedLocale = localStorage.getItem("locale");
      const locale = queryLocale === "en" || queryLocale === "zh" ? queryLocale : storedLocale === "en" || storedLocale === "zh" ? storedLocale : "zh";
      document.documentElement.dataset.locale = locale;
      document.documentElement.lang = locale;
      localStorage.setItem("locale", locale);
    </script>
  </head>
  <body>
    <ScrollProgress />
    <SiteHeader locale={locale} currentPath={Astro.url.pathname} alternatePath={alternatePath} />
    <main>
      <slot />
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>
