---
import ArticleHeader from "@/components/ArticleHeader.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { BlogPost } from "@/lib/posts";
import { localizePath, type Locale } from "@/i18n/config";
import { getUi } from "@/i18n/ui";

interface Props {
  post: BlogPost;
  locale: Locale;
  alternatePath?: string;
  headings: { depth: number; slug: string; text: string }[];
}

const { post, locale, alternatePath, headings } = Astro.props;
const t = getUi(locale);
---

<BaseLayout title={post.data.title} description={post.data.description} locale={locale} alternatePath={alternatePath}>
  <article class="container">
    <ArticleHeader post={post} locale={locale} />
    <div class="article-grid">
      <div></div>
      <div class="article-content glass">
        <slot />
      </div>
      {post.data.toc ? <TableOfContents headings={headings} /> : <div></div>}
    </div>
    <footer class="post-footer">
      <p>{t.article.copyright}</p>
      <a href={localizePath(locale, "/archive/")}>{t.article.browseArchive} →</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .article-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, var(--article)) 220px;
    gap: 1.2rem;
    align-items: start;
  }

  .article-content {
    border-radius: var(--radius-lg);
    padding: clamp(1.2rem, 4vw, 2.4rem);
  }

  .post-footer {
    width: min(100%, var(--article));
    margin: 1.2rem auto 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--muted);
    padding: 1rem 1.2rem;
  }

  .post-footer p {
    margin: 0 0 0.5rem;
  }

  .post-footer a {
    color: var(--primary);
  }

  @media (max-width: 1080px) {
    .article-grid {
      grid-template-columns: 1fr;
    }

    .article-grid > div:first-child,
    .article-grid > div:last-child {
      display: none;
    }
  }
</style>
